# Gemini on Vertex AI (server-only)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-pro
FIRESTORE_DATABASE_ID=(default)
# Use Application Default Credentials locally; never commit a service-account key.

# Parallel Search API (server-only)
PARALLEL_API_KEY=your-parallel-api-key

# Optional. Enables deterministic sample responses without cloud credentials.
# Never set this to true in a judged production deployment.
STUDIOCOPILOT_DEMO_MODE=false

# Firebase Authentication client settings. These identifiers are intentionally
# browser-visible; obtain them from Firebase Console > Project settings > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
FIREBASE_AUTH_PROJECT_ID=your-project-id

# Optional server-side allowlist. Leave empty to permit any verified Firebase user.
STUDIOCOPILOT_ALLOWED_EMAILS=producer@example.com
