# Gemini on Vertex AI (server-only)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-pro
FIRESTORE_DATABASE_ID=(default)
# Use Application Default Credentials locally; never commit a service-account key.

# Parallel Search API (server-only)
PARALLEL_API_KEY=your-parallel-api-key

# Optional. Enables deterministic sample responses without cloud credentials.
# Never set this to true in a judged production deployment.
STUDIOCOPILOT_DEMO_MODE=false
